# Active Learning Configuration File - Example
# Copy this to config.yaml and customize for your needs

# ============================================
# LLM CONFIGURATION
# ============================================
llm:
  # Provider options: 'ollama', 'openai', or 'gemini'
  provider: openai
  
  # Ollama settings (when provider=ollama)
  ollama:
    base_url: http://localhost:11434
    model: qwen2.5:7b  
  
  # OpenAI settings (when provider=openai)
  # Supports both standard OpenAI and Azure OpenAI
  openai: 
    api_key: YOUR_API_KEY_HERE
    azure_endpoint: https://your-endpoint.openai.azure.com/
    model: gpt-4o-2024-11-20 
    
  # Gemini settings (when provider=gemini)
  gemini:
    api_key: YOUR_GEMINI_API_KEY
    model: gemini-2.5-flash

# ============================================
# DATASET CONFIGURATION
# ============================================
dataset:
  # Training dataset (for AL pool)
  train_file: emotions_train.csv  # filename in input_data/ folder
  
  # Test dataset (for evaluation)
  test_file: emotions_test.csv   # filename in input_data/ folder
  
  # Column names in CSV
  columns:
    id: id
    text: example
    label: Label
  
  # Labels to exclude from processing (e.g., 'none', 'neutral', null values)
  exclude_labels:
    - none
    - None
    - null
    - ""

# ============================================
# PROCESSING SETTINGS
# ============================================
processing:
  # Random seed for reproducibility
  seed: 42

# ============================================
# DIRECTORY CONFIGURATION
# ============================================
directories:
  input_data: input_data
  output_data: output_data

# ============================================
# ACTIVE LEARNING CONFIGURATION
# ============================================
active_learning:
  enabled: true
  
  # Budget and batch settings
  total_budget: 120            # Total examples to label
  batch_size: 10               # Examples per iteration
  initial_labeled_per_class: 5  # Initial seed set per class
  
  # Query strategy settings
  query_strategy: "uncertainty"  # Options: "uncertainty", "random"
  uncertainty_method: "entropy"  # Options: "entropy", "margin", "least_confident" (only used when query_strategy="uncertainty")
  
  # Counterfactual augmentation with quality filtering (Paper's Algorithm 1)
  counterfactuals:
    enabled: true              # Enable/disable counterfactual generation
    
    # Generation budget (fixed-budget approach from paper)
    max_per_example: 3          # Exactly 3 CFs generated per labeled example
    cf_total_budget: 200        # Total CFs across entire AL run (-1 for unlimited)
    
    # Quality filtering (Paper's Algorithm 1: two filters only)
    quality_filtering:
      enabled: true
      # Filter 1: Label Correctness - p(y_target | CF) > p(y_orig | CF) + min_margin
      min_margin: 0.1           # Minimum probability margin for label flip
      min_target_confidence: 0.3  # Minimum confidence in target label
      # Filter 2: Semantic Similarity - cosine_similarity >= min_semantic_similarity
      min_semantic_similarity: 0.6  # Minimum semantic similarity to preserve context
      embedding_model: "all-MiniLM-L6-v2"  # Model for semantic similarity
    
    # Distribution strategy
    distribution_strategy: "balanced"  # Options: "balanced", "priority", "random"
    
    # Generation settings
    generation_temperature: 0.7
    max_tokens: 256
    prompt_variation: true      # Use varied prompts for multiple CFs per label
  
  # Stopping criteria
  max_iterations: 50
  early_stopping_patience: 5  # Stop if no improvement for N iterations
  min_improvement: 0.01       # Minimum F1 Macro improvement threshold

# ============================================
# EVALUATION CONFIGURATION
# ============================================
evaluation:
  # Classifier type: "static" (original) or "retrieval" (new)
  classifier_type: "retrieval"  # Options: "static", "retrieval"
  
  max_icl_examples: 800     # Max examples to include in ICL prompt (for static ICL)
  eval_every_iterations: 1  # Evaluate every N iterations
  
  # Retrieval-based ICL settings (used when classifier_type="retrieval")
  retrieval:
    # Embedding backend configuration
    embedding_backend: "sentence_transformers"  # Options: sentence_transformers, openai, tfidf
    
    # Sentence Transformers settings
    sentence_transformers:
      model: "all-MiniLM-L6-v2"  # Lightweight, fast model (22MB)
      device: "cpu"  # or "cuda" for GPU acceleration
      
    # OpenAI embeddings settings (requires API key, costs money)
    openai:
      model: "text-embedding-3-small"
      batch_size: 100
      
    # TF-IDF settings (lightweight fallback, no extra dependencies)
    tfidf:
      max_features: 1000
      ngram_range: [1, 2]
    
    # Retrieval strategy parameters
    k_per_class: 3           # Number of examples to retrieve per class (balanced)
    total_k_max: 30          # Maximum total examples to use (token budget limit)
    fallback_strategy: "similarity"  # How to fill remaining: "similarity" or "none"

# ============================================
# LOGGING CONFIGURATION
# ============================================
logging:
  checkpoint_every: 5       # Save checkpoint every N iterations
  checkpoint_dir: "output_data/al_checkpoints"
  results_file: "output_data/al_results.csv"
