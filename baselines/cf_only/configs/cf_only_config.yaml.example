# CF-Only Ablation Study Configuration (Example)
# Copy this file to cf_only_config.yaml and update with your settings

# ============================================
# LLM CONFIGURATION
# ============================================
llm:
  provider: openai
  
  openai: 
    api_key: YOUR_API_KEY_HERE
    azure_endpoint: YOUR_AZURE_ENDPOINT_HERE
    model: gpt-4o-2024-11-20

# ============================================
# DATASET CONFIGURATION
# ============================================
dataset:
  train_file: yelp_train.csv
  test_file: yelp_test.csv
  
  columns:
    id: id
    text: example
    label: Label
  
  exclude_labels:
    - none
    - None
    - null
    - ""

# ============================================
# PROCESSING SETTINGS
# ============================================
processing:
  seed: 42

# ============================================
# DIRECTORY CONFIGURATION
# ============================================
directories:
  input_data: ../../input_data

# ============================================
# ACTIVE LEARNING CONFIGURATION (for seed set)
# ============================================
active_learning:
  initial_labeled_per_class: 5  # Seed set size per class
  
  counterfactuals:
    enabled: true
    max_per_example: 3
    alpha_cf: 1.0
    
    quality_filtering:
      enabled: true
      tau_conf: 0.4
      delta: 0.1
      s_min: 0.7
      s_max: 0.98
      r_min: 0.7
      r_max: 1.3
      alpha: 0.3
      beta: 0.5
      embedding_model: "all-MiniLM-L6-v2"
    
    target_label_selection:
      strategy: "confusion"
      lambda: 0.5
    
    generation_temperature: 0.0
    max_tokens: 256
    prompt_variation: true

# ============================================
# EVALUATION CONFIGURATION
# ============================================
evaluation:
  classifier_type: "static"  # Options: "static", "retrieval"
  max_icl_examples: 800
  
  # Retrieval settings (if classifier_type="retrieval")
  retrieval:
    embedding_backend: "bm25"  # Options: "bm25", "contriever", "bge_large"
    k_per_class: 5
    total_k_max: 50
    fallback_strategy: "similarity"

# ============================================
# CF-ONLY ABLATION CONFIGURATION
# ============================================
cf_only:
  # Budgets to test (number of random factuals to select)
  budgets: [10, 20, 30, 40, 50, 100]

